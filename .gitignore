# Environnement virtuel et caches Python
__pycache__/
*.pyc
.venv/
env/
venv/

# Fichiers de configuration sensible
.env

# Données locales de backtest
*.csv
# Exception : matrice de corrélation calculée (référence pour account_router.py),
# pas une donnée de backtest/log — utile de la versionner.
!correlation_matrix.csv
# Exception : population B_tradable finale (gold/silver + palladium/platine),
# nécessaire à la reprise du pipeline ailleurs — pas une donnée de backtest jetable.
!chantier_gold_silver_pop_B_tradable_pgp_2026-08-20.csv
# Exception : backfill H1 MT5 (2026-08-21) demandé par le projet de simulation
# pour combler le trou Yahoo Finance (>730j) — donnée de référence longue durée,
# pas un résultat de run jetable.
!data/mt5_h1_backfill/*.csv
# Exception : historique brut des signaux scrapés Lutessia (source de TOUTES
# les populations dérivées du projet, ex. build_realistic_payoff_population)
# — donnée source foundationnelle, pas un résultat de run jetable. Oubli
# corrigé 2026-08-23 (absence bloquait la reprise du pipeline sur le VPS).
!historique_lutessia_15k_force.csv

# Cache de bougies H1 (Yahoo Finance) et logs d'exécution
yfinance_cache/
*.log

# État runtime (drawdown par compte, cache calendrier économique, trailing stop,
# suivi des emails déjà traités, verrou mono-instance)
account_risk_state.json
ff_calendar_cache.json
trailing_stop_state.json
processed_emails.json
app.lock
