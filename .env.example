# Configuration des Webhooks et Alertes
WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
API_KEY=your_secret_api_key_here
ENVIRONMENT=development

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Email (IMAP)
IMAP_SERVER=imap.gmail.com
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# MT5 -- flotte copytrade jusqu'à 3 comptes/3 firms. Compte de base (sans suffixe) =
# 1er compte actif (ex: FTMO). Ajouter les blocs _2/_3 (The5%ers, Blueberry Funded)
# dès qu'ils existent réellement -- app_mt5.load_accounts() les prend en compte
# automatiquement, aucun changement de code nécessaire. Tant qu'un bloc _n est
# incomplet ou absent, ce compte est simplement ignoré (pas d'erreur).
MT5_LOGIN=your_mt5_account_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=YourBroker-Server
MT5_ACCOUNT_ID=ftmo_swing

# 2e compte (ex: The5%ers) -- décommenter et remplir une fois le compte ouvert
# MT5_LOGIN_2=your_2nd_mt5_account_number
# MT5_PASSWORD_2=your_2nd_mt5_password
# MT5_SERVER_2=YourBroker2-Server
# MT5_ACCOUNT_ID_2=the5ers

# 3e compte (ex: Blueberry Funded) -- décommenter et remplir une fois le compte ouvert
# MT5_LOGIN_3=your_3rd_mt5_account_number
# MT5_PASSWORD_3=your_3rd_mt5_password
# MT5_SERVER_3=YourBroker3-Server
# MT5_ACCOUNT_ID_3=blueberry

# Compte de test (2026-08) -- utilise le prochain slot numéroté libre (_2, _3... selon
# ce qui est déjà configuré ci-dessus). Sert uniquement à collecter des données réelles
# (exécution + slippage, cf. slippage_logger.py) avant l'ouverture des 3 comptes
# principaux -- risque laissé à RISK_PCT_PER_TRADE=0.5 (app_mt5.py), aucun réglage par
# compte nécessaire, ce paramètre est global à la flotte. Participera au routage
# copytrade normal (account_router.eligible_accounts) comme n'importe quel autre compte
# configuré, dès que login/password/server sont remplis -- aucun changement de code.

# CentralCharts (nécessaire pour lire les fiches d'analyses Lutessia EN COURS, non
# publiques sans compte connecté — cf. scraper.create_authenticated_session)
CENTRALCHARTS_EMAIL=your_centralcharts_email_or_username
CENTRALCHARTS_PASSWORD=your_centralcharts_password
